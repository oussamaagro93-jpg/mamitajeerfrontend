# Frontend environment configuration (recommended: same-origin reverse proxy)
#
# Requests are sent to the relative path /api/v1. No CORS is involved:
#   - local dev:  Vite's dev-server proxy (vite.config.js) forwards /api -> http://localhost:5000
#   - production: Vercel's rewrite (vercel.json) proxies /api -> https://tajeer-backend.vercel.app
#
# Leave VITE_API_URL EMPTY to use the proxy. Only set it to call the backend
# directly by absolute URL (that bypasses the proxy and requires backend CORS).
# VITE_API_URL=
VITE_API_URL=http://localhost:5000

# Public origin used to build storefront links (e.g. {URL}/products/{slug}).
# Storefront and admin are the same app, so this is the frontend domain.
# For local development you may use http://localhost:3013 instead.
# VITE_STOREFRONT_URL=https://tajeer-frontend.vercel.app
VITE_STOREFRONT_URL=http://localhost:3013

VITE_META_PIXEL_ID=your_pixel_id
